# Local server. These defaults keep the app reachable only from this machine.
HOST=127.0.0.1
PORT=4310

# Set to 0 to disable the Chromium fallback for JavaScript-rendered logos.
BROWSER_DISCOVERY=1

# Optional fallbacks. Leave blank for the normal self-contained local setup.
JINA_API_KEY=
BESTICON_URL=

# Optional public-demo overrides. Local development normally uses the defaults.
PUBLIC_DEMO_ALLOW_JINA=1
PUBLIC_DEMO_BROWSER=1
PUBLIC_DEMO_WIKIMEDIA=1
PUBLIC_DEMO_BIMI=0

{
  "name": "logo-yoink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Find and rank the best logo assets exposed by a company website.",
  "homepage": "https://logo-yoink.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hendrikc4/logo-yoink.git"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "cli": "node src/cli.mjs",
    "benchmark": "node scripts/benchmark/benchmark.mjs",
    "contact-sheet": "node scripts/review/contact-sheet.mjs",
    "review-montage": "node scripts/review/review-montage.mjs",
    "browser-observations:warm": "node scripts/experiments/warm-browser-observations.mjs",
    "browser-observations:replay": "node scripts/experiments/replay-browser-observations.mjs",
    "identity-verifier": "node scripts/experiments/identity-verifier.mjs",
    "rerank-run": "node scripts/experiments/rerank-run.mjs",
    "merge-review-runs": "node scripts/review/merge-review-runs.mjs",
    "transfer-review-labels": "node scripts/review/transfer-review-labels.mjs",
    "review-labels": "node scripts/review/build-review-labels.mjs",
    "visual-benchmark:shards": "node scripts/benchmark/visual-benchmark-shards.mjs",
    "visual-benchmark:capture": "node scripts/benchmark/visual-capture.mjs",
    "visual-benchmark:review": "node scripts/review/visual-review-packet.mjs",
    "visual-benchmark:label-sheets": "node scripts/review/visual-label-sheets.mjs",
    "visual-benchmark:label-safety": "node scripts/review/apply-visual-label-safety.mjs",
    "visual-benchmark:validate": "node scripts/benchmark/visual-benchmark-validate.mjs",
    "visual-benchmark:merge": "node scripts/benchmark/visual-benchmark-merge.mjs",
    "visual-benchmark:agreement": "node scripts/review/visual-benchmark-agreement.mjs",
    "visual-benchmark:replay": "node scripts/benchmark/visual-benchmark-replay.mjs",
    "test": "node --test && node scripts/maintenance/validate-fixtures.mjs",
    "smoke": "node scripts/maintenance/smoke-local.mjs",
    "check:syntax": "node scripts/maintenance/check-syntax.mjs",
    "check": "npm run check:syntax && node scripts/maintenance/validate-benchmark-qualification.mjs && npm test && npm run smoke",
    "fixtures:validate": "node scripts/maintenance/validate-fixtures.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "htmlparser2": "^10.1.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3"
  }
}

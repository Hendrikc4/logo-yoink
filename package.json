{
  "name": "logo-yoink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Find and rank the best logo assets exposed by a company website.",
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "cli": "node src/cli.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "contact-sheet": "node scripts/contact-sheet.mjs",
    "review-montage": "node scripts/review-montage.mjs",
    "browser-observations:warm": "node scripts/warm-browser-observations.mjs",
    "browser-observations:replay": "node scripts/replay-browser-observations.mjs",
    "rerank-run": "node scripts/rerank-run.mjs",
    "merge-review-runs": "node scripts/merge-review-runs.mjs",
    "transfer-review-labels": "node scripts/transfer-review-labels.mjs",
    "review-labels": "node scripts/build-review-labels.mjs",
    "visual-benchmark:shards": "node scripts/visual-benchmark-shards.mjs",
    "visual-benchmark:capture": "node scripts/visual-capture.mjs",
    "visual-benchmark:review": "node scripts/visual-review-packet.mjs",
    "visual-benchmark:validate": "node scripts/visual-benchmark-validate.mjs",
    "visual-benchmark:merge": "node scripts/visual-benchmark-merge.mjs",
    "test": "node --test && node scripts/validate-fixtures.mjs",
    "fixtures:validate": "node scripts/validate-fixtures.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "htmlparser2": "^10.1.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3"

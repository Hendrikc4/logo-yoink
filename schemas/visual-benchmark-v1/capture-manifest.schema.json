{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logo-yoink.local/schemas/visual-benchmark-v1/capture-manifest.schema.json",
  "title": "Browser capture worker manifest",
  "description": "Operational manifest written by the browser capture worker. It is deliberately separate from benchmark-manifest.json, which owns assignment and split metadata.",
  "type": "object",
  "required": ["schema_version", "record_type", "benchmark_version", "capture_version", "assignment_manifest", "generated_at", "shard_count", "shard_index", "owned_shards", "entity_count", "assigned_count", "entity_ids", "completed_entity_ids", "aggregate_files", "provenance"],
  "properties": {
    "schema_version": {"const": "visual-benchmark-v1"},
    "record_type": {"const": "capture_manifest"},
    "benchmark_version": {"const": 1},
    "capture_version": {"type": "string", "minLength": 1},
    "assignment_manifest": {"type": ["string", "null"]},
    "assignment_manifest_digest": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "fixture": {"type": ["string", "null"]},
    "created_at": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "config_hash": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "worker_id": {"type": ["string", "null"]},
    "task_id": {"type": ["string", "null"]},
    "shard_count": {"type": "integer", "minimum": 1},
    "shard_index": {"type": "integer", "minimum": 0},
    "owned_shards": {"type": "array", "items": {"type": "object", "required": ["shard_id", "entity_ids", "entity_count"], "properties": {"shard_id": {"type": "integer", "minimum": 0}, "entity_ids": {"type": "array", "items": {"type": "string"}}, "entity_count": {"type": "integer", "minimum": 0}}, "additionalProperties": true}},
    "assigned_count": {"type": "integer", "minimum": 0},
    "entity_count": {"type": "integer", "minimum": 0},
    "entity_ids": {"type": "array", "items": {"type": "string"}},
    "completed_entity_ids": {"type": "array", "items": {"type": "string"}},
    "browser_version": {"type": ["string", "array", "null"]},
    "budget_state": {"type": "object", "additionalProperties": true},
    "config": {"type": "object", "additionalProperties": true},
    "aggregate_files": {"type": "object", "additionalProperties": {"type": "string"}},
    "provenance": {"type": "object", "required": ["schema_version", "capture_version"], "properties": {"schema_version": {"const": "visual-benchmark-v1"}, "capture_version": {"type": "string"}}, "additionalProperties": true},
    "options": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": true
}

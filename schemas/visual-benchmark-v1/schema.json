    "box": {"type":"object", "required":["x","y","width","height"], "properties":{"x":{"type":"number"},"y":{"type":"number"},"width":{"type":"number","minimum":0},"height":{"type":"number","minimum":0}}, "additionalProperties":false},
    "provenance": {"type":"object", "required":["schema_version","capture_version"], "properties":{"schema_version":{"const":"visual-benchmark-v1"},"capture_version":{"type":"string","minLength":1},"extractor_revision":{"type":["string","null"]},"ranker_revision":{"type":["string","null"]},"task_id":{"type":["string","null"]},"model":{"type":["string","null"]},"prompt_version":{"type":["string","null"]},"captured_at":{"type":["string","null"]}}, "additionalProperties":true},
    "manifest": {
      "type":"object", "required":["schema_version","benchmark_version","fixture","seed","generated_at","counts","entities","shards","overlap","assignment_digest","stages"],

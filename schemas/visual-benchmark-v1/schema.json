        "entities":{"type":"array","items":{"$ref":"#/definitions/entity_assignment"}}, "shards":{"type":"array","items":{"$ref":"#/definitions/shard"}}, "overlap":{"type":"array","items":{"type":"string"}}, "stages":{"type":"object","additionalProperties":{"$ref":"#/definitions/stage"}}, "provenance":{"$ref":"#/definitions/provenance"}

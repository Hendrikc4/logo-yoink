        "schema_version":{"const":"visual-benchmark-v1"}, "benchmark_version":{"const":1}, "fixture":{"type":"string"}, "fixture_sha256":{"type":"string"}, "assignment_digest":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"}, "content_hash_groups":{"type":"array"}, "pilot_fixture":{"type":["string","null"]}, "pilot_entity_ids":{"type":"array","items":{"type":"string"}}, "pilot_external_controls":{"type":"array"}, "seed":{"type":"string","minLength":1}, "generated_at":{"type":"string"},

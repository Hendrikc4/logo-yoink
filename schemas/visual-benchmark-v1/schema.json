    "stage": {"type":"object","required":["status","required_files"],"properties":{"status":{"enum":["pending","running","complete","failed"]},"required_files":{"type":"array","items":{"type":"string"}}},"additionalProperties":true},
    "entity_capture": {"type":"object","required":["schema_version","record_type","entity_id","company_name","requested_website","capture_status","identity_status","reachability","captured_at","provenance"],"properties":{"schema_version":{"const":"visual-benchmark-v1"},"record_type":{"const":"entity_capture"},"entity_id":{"type":"string"},"company_name":{"type":"string"},"requested_website":{"type":"string"},"capture_status":{"enum":["pending","success","failure","incomplete"]},"identity_status":{"enum":["current","related_rebrand","wrong_site","ambiguous","unreachable"]},"reachability":{"enum":["live_first_party","redirected_related_identity","redirected_off_domain","parked_or_for_sale","expired_or_hijacked","blocked_interstitial","dns_tls_failure","incomplete_blank","ambiguous_identity"]},"final_url":{"type":["string","null"]},"captured_at":{"type":"string"},"provenance":{"$ref":"#/definitions/provenance"}},"additionalProperties":true},

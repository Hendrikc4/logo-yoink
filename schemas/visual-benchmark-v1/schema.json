    "visual_instance": {"type":"object","required":["schema_version","record_type","visual_instance_id","entity_id","view","visual_role","region","theme","visibility","instance_box","provenance"],"properties":{"schema_version":{"const":"visual-benchmark-v1"},"record_type":{"const":"visual_instance"},"visual_instance_id":{"type":"string"},"entity_id":{"type":"string"},"view":{"type":"string"},"visual_role":{"type":"string"},"region":{"type":"string"},"theme":{"type":"string"},"visibility":{"type":"string"},"instance_box":{"$ref":"#/definitions/box"},"candidate_id":{"type":["string","null"]},"provenance":{"$ref":"#/definitions/provenance"}},"additionalProperties":true},
    "mapping": {"type":"object","required":["schema_version","record_type","mapping_id","entity_id","visual_instance_id","mapping_confidence","provenance"],"properties":{"schema_version":{"const":"visual-benchmark-v1"},"record_type":{"const":"mapping"},"mapping_id":{"type":"string"},"entity_id":{"type":"string"},"visual_instance_id":{"type":"string"},"candidate_id":{"type":["string","null"]},"mapping_confidence":{"type":"string"},"unmapped_reason":{"type":["string","null"]},"provenance":{"$ref":"#/definitions/provenance"}},"additionalProperties":true},
    "label": {"type":"object","required":["schema_version","record_type","label_id","label_kind","entity_id","reviewer_id","reviewer_kind","reviewed_at","provenance"],"properties":{"schema_version":{"const":"visual-benchmark-v1"},"record_type":{"const":"label"},"label_id":{"type":"string"},"label_kind":{"type":"string"},"entity_id":{"type":"string"},"reviewer_id":{"type":"string"},"reviewer_kind":{"type":"string"},"reviewed_at":{"type":"string"},"confidence":{"type":["number","string","null"]},"provenance":{"$ref":"#/definitions/provenance"}},"additionalProperties":true},
    "adjudication": {"type":"object","required":["schema_version","record_type","adjudication_id","entity_id","status","provenance"],"properties":{"schema_version":{"const":"visual-benchmark-v1"},"record_type":{"const":"adjudication"},"adjudication_id":{"type":"string"},"entity_id":{"type":"string"},"status":{"type":"string"},"decision":{"type":["object","null"]},"provenance":{"$ref":"#/definitions/provenance"}},"additionalProperties":true},
    "rejection": {"type":"object","required":["schema_version","record_type","rejection_id","entity_id","stage","reason","provenance"],"properties":{"schema_version":{"const":"visual-benchmark-v1"},"record_type":{"const":"rejection"},"rejection_id":{"type":"string"},"entity_id":{"type":"string"},"candidate_id":{"type":["string","null"]},"stage":{"enum":["discovery","parse","download_budget","validation","deduplication","generic_asset","role_eligibility","rank_threshold","identity_filter","shape_quality","theme_serialization","mapping","other"]},"reason":{"type":"string"},"provenance":{"$ref":"#/definitions/provenance"}},"additionalProperties":true},
    "capture_assignment": {"type":"object","required":["schema_version","record_type","entity_id","name","website","cohort","benchmark_split","capture_shard","label_shard","qa_overlap"],"properties":{"schema_version":{"const":"visual-benchmark-v1"},"record_type":{"const":"capture_assignment"},"entity_id":{"type":"string"},"name":{"type":"string"},"website":{"type":"string"},"cohort":{"type":"string"},"benchmark_split":{"type":"string"},"capture_shard":{"type":"integer"},"label_shard":{"type":"integer"},"qa_overlap":{"type":"boolean"}},"additionalProperties":true}
